local uis = game:GetService("UserInputService")

local player = game.Players.LocalPlayer
local GUI = player.PlayerGui.GUI
local auraValue = Instance.new("BoolValue")

auraValue.Parent = player
auraValue.Value = false

local function updateUI()
    if auraValue.Value == true then
        GUI.Top.Visible = false
        GUI.TopRight.Visible = false
        GUI.Winner.Visible = false
    else
        GUI.Top.Visible = true
        GUI.TopRight.Visible = true
        GUI.Winner.Visible = true
    end
end

uis.InputBegan:Connect(function(input)
    if (uis:GetFocusedTextBox()) then
        return;
    end
if input.KeyCode == Enum.KeyCode.H then
    if auraValue.Value == true then
        auraValue.Value = false
        else
        auraValue.Value = true
        end
    end
end)

while true do
    task.wait()
        updateUI()
end
